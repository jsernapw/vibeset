{
  "name": "@vibeset/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jsforce/jsforce-node": "^3.10.19",
    "@salesforce/apex-node": "^9.0.3",
    "@salesforce/core": "^9.1.2",
    "@salesforce/source-deploy-retrieve": "^13.1.1",
    "diff": "^7.0.0",
    "fast-xml-parser": "^4.5.0",
    "isomorphic-git": "^1.27.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "fast-check": "^4.9.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
